@model EPPlus9.WebSampleMvc.NetCore.Models.EPPlus9.HtmlExportShapesToSvgModel;
<div class="row">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/EPPlus9">EPPlus 9 samples</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sample 5</li>
            </ol>
        </nav>
    </div>
</div>
<form action="/EPPlus9/HtmlExportShapesToSvg" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="shape">Select a shape:</label>
        <select class="form-control" id="shape" name="shape">
            @foreach (var shape in Model.AllShapes)
            {
                <option value="@shape">@shape</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Reload</button>
    <button type="submit" class="btn btn-primary mt-2" name="action" value="excel">Download Workbook</button>
</form>
@if (Model.Svg != null)
{
    <div class="row mt-3">
        <div class="col-sm-12 col-md-6">
            <h5>SVG Output:</h5>
            @Html.Raw(Model.Svg)
        </div>
    </div>
}