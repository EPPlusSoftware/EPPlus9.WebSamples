@model EPPlus9.WebSampleMvc.NetCore.Models.EPPlus9.PdfExportRangeModel;
<div class="row">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/EPPlus9">EPPlus 9 samples</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sample 4</li>
            </ol>
        </nav>
    </div>
</div>
<div class="row">
    <div class="col text-center">
        <h4>Export a workbook with a range (border, fills, pictures, etc)</h4>
    </div>
</div>
<div class="row my-2">
    <div class="col bg-light rounded">
        <div class="row">
            <div class="col-6">
                <a href="/EPPlus9/PdfExportTable">&laquo; Previous sample</a>
            </div>
            <div class="col-6 text-right">
                <a  href="#" class="text-secondary disabled">Next sample &raquo;</a>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col my-3">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active" href="#" id="tab-demo">Demo</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#" id="tab-csharp">C#</a>
            </li>
        </ul>
    </div>
</div>
<div class="row demo">
    <div class="col">
        <form asp-action="PdfExportRange" method="post" id="form1">
        @Html.AntiForgeryToken()

    <div class="row mt-3">
        <div class="col-sm-1 col-md-2">
            <button type="submit" class="btn btn-sm btn-primary mt-2" name="action" value="excel">Download Workbook</button>
        </div>
        <div class="col-sm-1 col-md-2">
            <button type="submit" class="btn btn-sm btn-primary mt-2" name="action" value="pdf">Download Pdf</button>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-sm-12 col-md-6">
            <style>@Html.Raw(Model.Css)</style>       
            @Html.Raw(Model.Html)
        </div>
    </div>
</form>
    </div>
</div>
<div class="row csharp"  style="display:none">
    <div class="col">
        <p>C# code below
        <pre>
        <code class="language-csharp hljs">

var file = Path.Combine(webRootPath, "data\\Allsvenskan2001.xlsx");
var pkg = new ExcelPackage(file);
using var ms = new MemoryStream();
pck.Workbook.SaveAsPdf(ms);
return File(ms.ToArray(), "application/pdf", "EPPlus Sample 4.pdf");

            </code>
        </pre>
    </div>
</div>
<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {
        jQuery(".demo").show();
        jQuery(".csharp").hide();
        hljs.highlightAll();
        jQuery("#tab-csharp").click(function (e) {
            e.preventDefault();
            jQuery(".demo").hide();
            jQuery(".csharp").show();
            jQuery("#tab-demo").removeClass("active");
            jQuery("#tab-csharp").addClass("active");
        });
        jQuery("#tab-demo").click(function (e) {
            e.preventDefault();
            jQuery(".demo").show();
            jQuery(".csharp").hide();
            jQuery("#tab-demo").addClass("active");
            jQuery("#tab-csharp").removeClass("active");
        });
    });

    const form = document.querySelector('form');
    const btn = document.getElementById('btn-submit-form');
    const spinner = document.getElementById('btnSpinner');
    const text = document.getElementById('btnText');

    form.addEventListener('submit', (e) => {
        if (e.submitter && e.submitter.id === 'btn-submit-form') {
            btn.disabled = true;
            spinner.classList.remove('d-none');
        }
        });
    </script>