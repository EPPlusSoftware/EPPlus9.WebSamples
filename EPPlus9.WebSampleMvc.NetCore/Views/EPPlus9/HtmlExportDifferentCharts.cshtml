@model EPPlus9.WebSampleMvc.NetCore.Models.EPPlus9.HtmlExportDifferentChartsModel;
<style>@Html.Raw(Model.Css)</style>
<div class="row">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/EPPlus9">EPPlus 9 samples</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sample 2</li>
            </ol>
        </nav>
    </div>
</div>
<div class="row">
    <div class="col text-center">
        <h4>Exports a workbook with a chart and a table</h4>
    </div>
</div>
<div class="row my-2">
    <div class="col bg-light rounded">
        <div class="row">
            <div class="col-6">
                <a href="EPPlus9/HtmlExportwithCharts">&laquo; Previous sample</a>
            </div>
            <div class="col-6 text-right">
                <a href="EPPlus9/PdfExport">Next sample &raquo;</a>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col my-3">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active" href="#" id="tab-demo">Demo</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#" id="tab-csharp">C#</a>
            </li>
        </ul>
    </div>
</div>
<div class="row demo">
    <div class="col">
        <form asp-action="HtmlExportDifferentCharts" method="post" id="form1">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-sm-4 col-md-2">
            <label>Chart Type</label>
        </div>
        <div class="col-sm-4 col-md-2">
            <label>Chart Style</label>
        </div>
        <div class="col-sm-4 col-md-2">
            <label>Table Style</label>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4 col-md-2">
            @Html.DropDownListFor(x => x.ChartType, Model.SupportedChartTypes, new { @class = "form-control" })
        </div>
        <div class="col-sm-4 col-md-2">
            @Html.DropDownListFor(x => x.ChartStyle, Model.AllChartStyles, new { @class = "form-control" })
        </div>
        <div class="col-sm-4 col-md-2">
            @Html.DropDownListFor(x => x.TableStyle, Model.AllBuiltInTableStyles, new { @class = "form-control" })
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-sm-2 col-md-1">
            <button type="submit" class="btn btn-sm btn-primary mt-1" name="action" value="submit">Reload</button>
        </div>
        <div class="col-sm-1 col-md-2">
             <button type="submit" class="btn btn-sm btn-primary mt-1" name="action" value="download">Download Workbook</button>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col p-2 m-2">
            @Html.Raw(Model.SvgChart)
        </div>  
    </div>
    <div class="row mt-3">
        <div class="col">
            @Html.Raw(Model.Html)
        </div>
    </div>
        </form>
    </div>
</div>
<div class="row csharp"  style="display:none">
    <div class="col">
        <p>Code to generate the html/css and svg below</p>
        <pre>
        <code class="language-csharp hljs">

        </code>
        </pre>
    </div>
</div>

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {
        jQuery(".demo").show();
        jQuery(".csharp").hide();
        hljs.highlightAll();
        jQuery("#tab-csharp").click(function (e) {
            e.preventDefault();
            jQuery(".demo").hide();
            jQuery(".csharp").show();
            jQuery("#tab-demo").removeClass("active");
            jQuery("#tab-csharp").addClass("active");
        });
        jQuery("#tab-demo").click(function (e) {
            e.preventDefault();
            jQuery(".demo").show();
            jQuery(".csharp").hide();
            jQuery("#tab-demo").addClass("active");
            jQuery("#tab-csharp").removeClass("active");
        });

    form.addEventListener('submit', (e) => {
        if (e.submitter && e.submitter.id === 'btn-submit-form') {
            btn.disabled = true;
            spinner.classList.remove('d-none');
        }
    });
</script>